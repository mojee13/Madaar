{
  "name": "madar-commerce-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test src/services/demo.test.ts",
    "check": "tsc -b",
    "format": "prettier --write src README.md docs *.json *.ts index.html .github/workflows",
    "format:check": "prettier --check src README.md docs *.json *.ts index.html .github/workflows"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
